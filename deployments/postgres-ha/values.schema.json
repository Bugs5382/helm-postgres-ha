{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "postgres-ha values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicas",
    "image",
    "agent",
    "postgresql",
    "tls"
  ],
  "properties": {
    "fullnameOverride": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9]{0,38}[a-z0-9])?)?$"
    },
    "replicas": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "repository"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry",
            "repository"
          ],
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "leaseDuration": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
        },
        "renewDeadline": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
        },
        "retryPeriod": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
        },
        "rejoinTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
        },
        "promoteTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
        },
        "peerTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
        },
        "maxLagOnFailover": {
          "type": "integer",
          "minimum": 0
        },
        "readyMaxLag": {
          "type": "integer",
          "minimum": 0
        },
        "logLevel": {
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "logFormat": {
          "enum": [
            "json",
            "console"
          ]
        },
        "otlpEndpoint": {
          "type": "string",
          "pattern": "^([^:/]+:[0-9]+)?$"
        },
        "initResources": {
          "type": "object"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|K|M|G|T|P)?$"
        },
        "storageClassName": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod",
              "ReadWriteMany"
            ]
          }
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedCIDRs"
      ],
      "properties": {
        "allowedCIDRs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        },
        "synchronous": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "quorum",
                "strict",
                "off"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "initdbArgs": {
          "type": "string"
        },
        "extraHBA": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]{0,62}$"
          },
          "existingSecret": {
            "type": "string"
          },
          "passwordKey": {
            "type": "string"
          },
          "createdb": {
            "type": "boolean"
          },
          "createrole": {
            "type": "boolean"
          },
          "connectionLimit": {
            "type": "integer",
            "minimum": -1
          },
          "inRoles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "databases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]{0,62}$"
          },
          "owner": {
            "type": "string"
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "superuser": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "replication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "rewind": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "pgbouncer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuerRef": {
              "type": "object"
            },
            "duration": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
            },
            "renewBefore": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
            }
          }
        },
        "existingSecret": {
          "type": "string"
        },
        "pgbouncerExistingSecret": {
          "type": "string"
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "initdb",
            "restore"
          ]
        },
        "restore": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backup": {
              "type": "string",
              "minLength": 1
            },
            "prefix": {
              "type": "string",
              "pattern": "^([a-z0-9]+://[^']+)?$"
            },
            "targetTime": {
              "type": "string"
            },
            "targetLSN": {
              "type": "string",
              "pattern": "^([0-9A-Fa-f]+/[0-9A-Fa-f]+)?$"
            },
            "targetName": {
              "type": "string"
            },
            "targetExclusive": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "minLength": 9
        },
        "source": {
          "enum": [
            "standby",
            "primary"
          ]
        },
        "retainFull": {
          "type": "integer",
          "minimum": 1
        },
        "retainDays": {
          "type": "integer",
          "minimum": 0
        },
        "timeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
        },
        "storage": {
          "type": "string",
          "enum": [
            "s3",
            "file"
          ]
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefix": {
              "type": "string",
              "pattern": "^([a-z0-9]+://[^']+)?$"
            },
            "endpoint": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "forcePathStyle": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "file": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mountPath": {
              "type": "string",
              "pattern": "^/[^']*[^/']$"
            },
            "prefix": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]*$"
            },
            "existingClaim": {
              "type": "string"
            },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {
                  "type": "string",
                  "minLength": 1
                },
                "storageClassName": {
                  "type": "string"
                },
                "accessModes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "enum": [
                      "ReadWriteOnce",
                      "ReadWriteMany",
                      "ReadWriteOncePod"
                    ]
                  }
                }
              }
            }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^WALG_[A-Z0-9_]+$"
          }
        },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "schedule": {
              "type": "string",
              "minLength": 9
            },
            "database": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]{0,62}$"
            },
            "query": {
              "type": "string",
              "minLength": 1
            },
            "timeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
            },
            "scratchSize": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|K|M|G|T|P)?)?$"
            },
            "resources": {
              "type": "object"
            }
          }
        }
      }
    },
    "pgbouncer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registry",
            "repository"
          ],
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "poolMode": {
          "enum": [
            "session",
            "transaction",
            "statement"
          ]
        },
        "defaultPoolSize": {
          "type": "integer",
          "minimum": 1
        },
        "maxClientConn": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        },
        "maxDbConnections": {
          "type": "integer",
          "minimum": 0
        },
        "reservePoolSize": {
          "type": "integer",
          "minimum": 0
        },
        "serverIdleTimeout": {
          "type": "integer",
          "minimum": 0
        },
        "sessionDatabases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]{0,62}$"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowedClients": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metricsFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "apiServer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "ports": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "extraEgress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "affinity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "podAntiAffinity": {
          "enum": [
            "hard",
            "soft"
          ]
        },
        "topologyKey": {
          "type": "string"
        },
        "zoneSpread": {
          "type": "boolean"
        },
        "extra": {
          "type": "object"
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "priorityClassName": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 30
    },
    "podLabels": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
        },
        "labels": {
          "type": "object"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exporters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "postgres": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "registry",
                    "repository"
                  ],
                  "properties": {
                    "registry": {
                      "type": "string",
                      "minLength": 1
                    },
                    "repository": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tag": {
                      "type": "string"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^(sha256:[a-f0-9]{64})?$"
                    },
                    "pullPolicy": {
                      "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                      ]
                    }
                  }
                },
                "resources": {
                  "type": "object"
                }
              }
            },
            "pgbouncer": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "registry",
                    "repository"
                  ],
                  "properties": {
                    "registry": {
                      "type": "string",
                      "minLength": 1
                    },
                    "repository": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tag": {
                      "type": "string"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^(sha256:[a-f0-9]{64})?$"
                    },
                    "pullPolicy": {
                      "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                      ]
                    }
                  }
                },
                "resources": {
                  "type": "object"
                }
              }
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "replicationLagBytes": {
              "type": "integer",
              "minimum": 1
            },
            "backupMaxAgeHours": {
              "type": "integer",
              "minimum": 1
            },
            "diskUsedPercent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            }
          }
        }
      }
    }
  }
}
