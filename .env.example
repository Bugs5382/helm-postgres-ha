# Local development settings. Copy to .env (git-ignored) and load it in the
# run target, for example with `dotenv: ['.env']` in the Taskfile.
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

# The agent's settings. In a cluster the chart sets all of them; the values
# below are the agent's own defaults (empty means required).
POD_NAME=
POD_NAMESPACE=
POD_REVISION=
PGHA_CLUSTER=
PGHA_HEADLESS_SERVICE=
PGHA_REPLICAS=3
PGHA_LEASE=
PGHA_BACKUP_LEASE=
PGDATA=/var/lib/postgresql/data/pgdata
PGHA_CONFIG_DIR=/etc/pgha/config
PGHA_SECRETS_DIR=/etc/pgha/secrets
PGHA_TLS_DIR=/etc/pgha/tls
PGHA_RUN_DIR=/run/pgha
PGHA_BIN_DIR=/pgha/bin
PGHA_SOCKET_DIR=/var/run/postgresql
PGHA_HTTP_ADDR=:8008
PGHA_PEER_ADDR=:8009
PGHA_LEASE_DURATION=15s
PGHA_RENEW_DEADLINE=10s
PGHA_RETRY_PERIOD=2s
PGHA_REJOIN_TIMEOUT=60s
PGHA_PROMOTE_TIMEOUT=30s
PGHA_PEER_TIMEOUT=2s
PGHA_SHUTDOWN_TIMEOUT=60s
PGHA_MAX_LAG_ON_FAILOVER=1048576
PGHA_READY_MAX_LAG=67108864
PGHA_SYNC_MODE=quorum
PGHA_SYNC_COUNT=1
PGHA_INITDB_ARGS=--encoding=UTF8 --locale=C.UTF-8 --data-checksums
PGHA_BOOTSTRAP_MODE=initdb
PGHA_RESTORE_BACKUP=LATEST
PGHA_RESTORE_PREFIX=
PGHA_RESTORE_TARGET_TIME=
PGHA_RESTORE_TARGET_LSN=
PGHA_RESTORE_TARGET_NAME=
PGHA_RESTORE_TARGET_EXCLUSIVE=false
PGHA_BACKUP_ENABLED=false
PGHA_BACKUP_SCHEDULE=0 3 * * *
PGHA_BACKUP_SOURCE=standby
PGHA_BACKUP_RETAIN_FULL=7
PGHA_BACKUP_RETAIN_DAYS=14
PGHA_BACKUP_TIMEOUT=6h
PGHA_PGBOUNCER_SERVICE=
OTEL_EXPORTER_OTLP_ENDPOINT=
